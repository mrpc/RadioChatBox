# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
# Key/channel namespace. Two installs that share one Redis server MUST use
# DISTINCT prefixes, or their realtime channels (chat:updates, private messages,
# now-playing) collide and one install's feed leaks into the other's clients.
# NOTE: a different REDIS_DATABASE is NOT enough — Redis pub/sub is global across
# databases. If left blank the prefix is derived from DB_NAME, so distinct
# databases are already isolated; set this explicitly to force a namespace when
# two installs share a database name.
# REDIS_PREFIX=station1

# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=radiochatbox
DB_USER=radiochatbox
DB_PASSWORD=radiochatbox_secret

# Chat Configuration
CHAT_MAX_MESSAGE_LENGTH=500
CHAT_RATE_LIMIT_SECONDS=2
CHAT_HISTORY_LIMIT=100
CHAT_MESSAGE_TTL=3600

# LLM for fake user auto-replies (DeepSeek) - OPTIONAL
# Configure these from the admin panel (Settings -> Fake User Auto-Replies).
# The variables below are only a fallback for deployments that prefer to keep
# secrets outside the database; leave them empty to use the admin settings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT=20

# CORS (for embedding in your radio page)
ALLOWED_ORIGINS=http://localhost:98,https://yourradiosite.com

# Git Webhook Configuration (for auto-deployment)
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
DEPLOY_BRANCH=main
