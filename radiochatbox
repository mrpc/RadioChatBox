#!/usr/bin/env bash
#
# RadioChatBox console — forwards to the CLI entry point (radiochatbox.php) inside
# the app container, the same way other Pramnos Framework apps wrap their CLI.
#
#   ./radiochatbox <command> [args...]     e.g.  ./radiochatbox bot:status
#   ./radiochatbox list                    all available commands
#
# For a container shell or the test suite, use ./dockerbash and ./dockertest.
#
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

# Docker Compose v2 (docker compose) with a fallback to the v1 binary.
if docker compose version >/dev/null 2>&1; then
    COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
    COMPOSE=(docker-compose)
else
    echo "Neither 'docker compose' nor 'docker-compose' is available." >&2
    exit 1
fi

# No TTY available (CI, pipes, editors): tell exec not to ask for one.
tty_flag=()
[[ -t 0 ]] || tty_flag=(-T)

exec "${COMPOSE[@]}" exec ${tty_flag[@]+"${tty_flag[@]}"} apache php radiochatbox.php "$@"
