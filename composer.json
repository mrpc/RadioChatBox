{
    "name": "radiochatbox/radiochatbox",
    "description": "A scalable, real-time chat application for radio shows using SSE, Redis, and PostgreSQL",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Yannis - Pastis Glaros"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/mrpc/PramnosFramework.git"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-redis": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-gd": "*",
        "mrpc/pramnosframework": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "RadioChatBox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RadioChatBox\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
