#!/usr/bin/env php
<?php

/**
 * RadioChatBox console entry point (PramnosFramework, migration Phase 2).
 *
 * This is a deliberately MINIMAL, console-safe framework bootstrap. It does NOT
 * call Application::init(), because init() runs web-oriented steps — notably
 * session start and SessionTrackingMiddleware, which would write to the
 * `sessions` table whose columns differ from the framework's (a known schema
 * collision, see docs/pramnos-migration/05-schema-convergence.md). Instead it
 * wires only what console commands need: the framework Settings (loaded from
 * app/settings/settings.php, which reads the environment via envvar()) and a
 * connected Database, handed to the Application instance the console commands read from.
 *
 * Usage (inside the app container): php bin/rcb <command>
 *   e.g. php bin/rcb migrate:status
 */

use Pramnos\Application\Application;
use Pramnos\Application\Settings;
use Pramnos\Database\Database;

if (!defined('ROOT')) {
    define('ROOT', dirname(__DIR__));
}

require ROOT . '/vendor/autoload.php';
require ROOT . '/bootstrap/pramnos.php';

if (!radiochatbox_boot_pramnos()) {
    fwrite(STDERR, "PramnosFramework is not available in this environment.\n");
    exit(1);
}

// Console-safe wiring: connect the DB and hand it to the Application singleton
// that the framework's console commands resolve via getInstance()->database.
$settings = Settings::getInstance();
$database = Database::getInstance($settings);
$database->connect();
Settings::setDatabase($database);

$application = Application::getInstance();
$application->database = $database;
$application->settings = $settings;

// Auto-run any pending (post-baseline) migrations on every console execution,
// as declared in app/app.php. The fingerprint fast-path makes this a no-op when
// the schema is current; the explicit `migrate` command still handles the full
// baseline (fresh installs / CI), which auto-run deliberately skips via cutoff.
$application->migrate();

$console = new \Pramnos\Console\Application();
// Register RadioChatBox's own console commands (the framework's daemon
// orchestrator is abstract; each app registers its concrete subclass).
$console->add(new \RadioChatBox\Console\RadioChatBoxDaemons());

// Bot worker + its operational commands (retired the root-level worker.php).
$console->add(new \RadioChatBox\Console\BotWorker());
$console->add(new \RadioChatBox\Console\BotStatus());
$console->add(new \RadioChatBox\Console\BotLog());
$console->add(new \RadioChatBox\Console\BotSchedule());
$console->add(new \RadioChatBox\Console\BotRunTask());
$console->add(new \RadioChatBox\Console\BotPruneLog());
$console->add(new \RadioChatBox\Console\BotFlush());

// Register the framework's native Redis health check (pings via the shared
// ConnectionManager) alongside the built-in database/disk/memory checks.
\Pramnos\Health\HealthRegistry::register(new \Pramnos\Health\Checks\RedisConnectivityCheck());

$console->run();
